{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-standards/schema/project.schema.json",
  "title": "Project override file (.forge/project.yaml, layer 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "standards_version"
  ],
  "properties": {
    "schema": {
      "const": "forge-standards/project/v1"
    },
    "profile": {
      "enum": [
        "spike",
        "standard",
        "produktion",
        "kritisch"
      ]
    },
    "standards_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "expires": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
      }
    }
  }
}
