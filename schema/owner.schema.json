{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-standards/schema/owner.schema.json",
  "title": "Owner principles (layer 0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "principles"
  ],
  "properties": {
    "schema": {
      "const": "forge-standards/owner/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "superseded"
      ]
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "short",
          "text",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G([1-9]|1[0-9]|2[0-9]|30)$"
          },
          "short": {
            "type": "string",
            "minLength": 8,
            "maxLength": 90
          },
          "text": {
            "type": "string",
            "minLength": 8
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
