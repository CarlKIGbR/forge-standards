{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-standards/schema/testing.schema.json",
  "title": "Test duties (section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "name",
    "levels",
    "dictated_tests",
    "failing_first",
    "mutation_sample",
    "legacy_tests",
    "never",
    "flake_policy",
    "measurement_runs",
    "ci_gate",
    "evidence_block",
    "assumptions"
  ],
  "properties": {
    "schema": {
      "const": "forge-standards/testing/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "superseded"
      ]
    },
    "name": {
      "const": "testing"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "required_from",
          "runs_in",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "smoke",
              "live_proof",
              "goldset",
              "property_fuzz"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "required_from": {
            "enum": [
              "spike",
              "standard",
              "produktion",
              "kritisch"
            ]
          },
          "runs_in": {
            "type": "string",
            "minLength": 3
          },
          "evidence": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "dictated_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "failing_first": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "mutation_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "legacy_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "never": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "flake_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "measurement_runs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "ci_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "evidence_block": {
      "type": "string",
      "minLength": 20
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
